# Telegram Bot 推送配置
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SMTP 邮件推送配置
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# OpenAI 或兼容接口配置，可选；不配置时使用规则模板摘要
# 兼容服务需要支持 POST /chat/completions，并能返回 JSON object。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=45

# NCBI PubMed 配置，建议填写，尤其是 GitHub Actions 中定时请求
NCBI_EMAIL=
NCBI_API_KEY=

# GitHub Repository 采集配置，可选；不配置时使用 GitHub REST API 未认证低限额
GITHUB_TOKEN=

# 运行时默认配置，可选
DIGEST_TIMEZONE=Asia/Shanghai
DIGEST_OUTPUT_DIR=data/digests

# top 期刊筛选由 config/sources.yml 和 config/journals.yml 控制；常用 CLI 覆盖参数：
# python scripts/daily_digest.py --top-journal-mode push --min-impact-factor 10 --preview --skip-telegram --skip-email
